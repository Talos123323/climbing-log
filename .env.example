# Copy to .env and fill in real values. NEVER commit a real .env.
# .env.example is safe to commit — it holds placeholders only.

# Which config class to use: development | testing | production
FLASK_CONFIG=development

# Flask app entry point (used by `flask` CLI and gunicorn via run:app)
FLASK_APP=run.py

# Secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production this MUST be set — the app refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-secret

# Database URL. Local dev default is SQLite; compose/Render use Postgres.
DATABASE_URL=sqlite:///dev.db

# JWT lifetime in hours (default 12)
JWT_TTL_HOURS=12

# --- Postgres (docker compose only) ---
# These three must match each other: the password in DATABASE_URL for the
# web service is built from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
POSTGRES_USER=climbing
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=climbing_log
